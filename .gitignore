# ===========================================================================
#  Vidocq workspace — .gitignore
#
#  This repository is meant to be checked out AS the root of your multi-repo
#  Vidocq working directory. The individual project repositories (vauban,
#  vidocq, cassini, champollion, chappe, foy, mansart, ravel, knock, dirac,
#  heisenberg, grimm, cyrano, cervantes, humboldt, …) are cloned INTO this
#  directory by the checkout tooling and each keeps its OWN independent git
#  repo. They must never be tracked here.
# ===========================================================================

# Ignore every top-level directory (the nested project clones)…
/*/
# …except this repo's payload: the shared Claude config, git hooks and docs.
!/.claude/
!/.githooks/
!/docs/

# --- Personal / local Claude Code config — never shared ---
.claude/settings.local.json
.claude/**/*.local.*
.claude.json

# --- Secrets must never live here (kept in ~/.config/vidocq/tokens.env) ---
*.env
!*.env.example
tokens*.env

# --- OS / editor noise ---
.DS_Store
**/.DS_Store
*.swp
*~
.idea/
*.iml

# …and the provenance audit tooling, which IS part of this repo (see PROVENANCE-AUDIT.md).
!/provenance-audit/

# …and the master prompts, which ARE part of this repo (see WORK_WITH_CLAUDE.md).
!/prompts/

# mani #
erasmus/main
grimm/main
humboldt/main
cyrano/main
cervantes/main
heisenberg/main
dirac/main
knock/main
ravel/main
mansart/main
foy/main
chappe/main
champollion/main
cassini/main
vauban/main
governance/main
ci/main
pages/main
vidocq-docs/main
vidocq-parent/main
vidocq/main
# mani #
