# ===========================================================================
#  Vidocq workspace — .gitignore
#
#  This repository is meant to be checked out AS the root of your Vidocq
#  working directory. The repositories listed in mani.yaml (the vidocq
#  monorepo, vidocq-docs, pages, ci, the VCU extensions, …) are cloned INTO
#  this directory by mani and each keeps its OWN independent git repo. They
#  must never be tracked here.
# ===========================================================================

# Ignore every top-level directory (the nested project clones)…
/*/
# …except this repo's payload: the shared Claude config, git hooks and docs.
!/.claude/
!/.githooks/
!/docs/

# --- Personal / local Claude Code config — never shared ---
.claude/settings.local.json
.claude/**/*.local.*
.claude.json

# --- Secrets must never live here (kept in ~/.config/vidocq/tokens.env) ---
*.env
!*.env.example
tokens*.env

# --- OS / editor noise ---
.DS_Store
**/.DS_Store
*.swp
*~
.idea/
*.iml

# …and the provenance audit tooling, which IS part of this repo (see PROVENANCE-AUDIT.md).
!/provenance-audit/

# …and the master prompts, which ARE part of this repo (see WORK_WITH_CLAUDE.md).
!/prompts/

# mani #
GestionProjet/main
ci/main
dep-graph/main
erasmus/main
governance/main
pages/main
tassis/main
vaadin-on-vidocq/main
vcu-template/main
verne/main
vidocq-benchmarks/main
vidocq-docs/main
vidocq-tutorial/main
vidocq/main
vidocq_vcu_extension_lc4jcdi/main
vidocq_vcu_extension_vaadin/main
# mani #
